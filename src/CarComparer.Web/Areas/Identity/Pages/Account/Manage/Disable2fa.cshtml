@page
@model Disable2faModel
@{
    ViewData["Title"] = "Wyłącz uwierzytelnianie dwuskładnikowe (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Ta czynność całkowicie wyłącza 2FA.</strong>
    </p>
    <p>
        Logowanie nie będzie już wymagać kodu, a klucz aplikacji uwierzytelniającej zostanie usunięty. Aby włączyć 2FA
        ponownie, trzeba będzie skonfigurować aplikację od nowa.
    </p>
</div>

<div class="d-flex flex-wrap gap-2">
    <form method="post">
        <button class="btn btn-danger" type="submit">Wyłącz 2FA</button>
    </form>
    <a class="btn btn-outline-secondary" asp-page="./TwoFactorAuthentication">Anuluj</a>
</div>

