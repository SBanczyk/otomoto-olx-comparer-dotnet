@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Uwierzytelnianie dwuskładnikowe (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
@{
    var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
    @if (consentFeature?.CanTrack ?? true)
    {
        @if (Model.Is2faEnabled)
        {
            if (Model.RecoveryCodesLeft == 0)
            {
                <div class="alert alert-danger">
                    <strong>Nie masz już kodów odzyskiwania.</strong>
                    <p>Musisz <a asp-page="./GenerateRecoveryCodes">wygenerować nowy zestaw kodów odzyskiwania</a>, zanim będzie można zalogować się kodem odzyskiwania.</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft == 1)
            {
                <div class="alert alert-danger">
                    <strong>Został 1 kod odzyskiwania.</strong>
                    <p>Możesz <a asp-page="./GenerateRecoveryCodes">wygenerować nowy zestaw kodów odzyskiwania</a>.</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft <= 3)
            {
                <div class="alert alert-warning">
                    <strong>Pozostałe kody odzyskiwania: @Model.RecoveryCodesLeft.</strong>
                    <p>Zalecamy <a asp-page="./GenerateRecoveryCodes">wygenerowanie nowego zestawu kodów odzyskiwania</a>.</p>
                </div>
            }

            <div class="d-flex flex-wrap gap-2 mb-4">
                @if (Model.IsMachineRemembered)
                {
                    <form method="post">
                        <button type="submit" class="btn btn-outline-secondary">Zapomnij tę przeglądarkę</button>
                    </form>
                }
                <a asp-page="./GenerateRecoveryCodes" class="btn btn-outline-secondary">Zresetuj kody odzyskiwania</a>
            </div>
        }

        <h4 class="h5">Aplikacja uwierzytelniająca</h4>
        <div class="d-flex flex-wrap gap-2">
            @if (!Model.HasAuthenticator)
            {
                <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">Dodaj aplikację uwierzytelniającą</a>
            }
            else
            {
                <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">Skonfiguruj aplikację uwierzytelniającą</a>
                <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-outline-secondary">Zresetuj aplikację</a>
                <a id="disable-2fa" asp-page="./Disable2fa" class="btn btn-outline-danger">Wyłącz 2FA całkowicie</a>
            }
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <strong>Nie zaakceptowano polityki prywatności i plików cookie.</strong>
            <p>Aby włączyć uwierzytelnianie dwuskładnikowe, musisz zaakceptować politykę.</p>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
