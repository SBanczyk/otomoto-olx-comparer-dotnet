@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generowanie kodów odzyskiwania uwierzytelniania dwuskładnikowego (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Zachowaj te kody w bezpiecznym miejscu.</strong>
    </p>
    <p>
        Jeśli utracisz urządzenie i nie będziesz mieć kodów odzyskiwania, stracisz dostęp do konta.
    </p>
    <p>
        Wygenerowanie nowych kodów odzyskiwania nie zmienia kluczy używanych w aplikacjach uwierzytelniających. Jeśli chcesz zmienić klucz
        używany w aplikacji uwierzytelniającej, <a asp-page="./ResetAuthenticator">zresetuj klucze uwierzytelniające.</a>
    </p>
</div>
<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Wygeneruj kody odzyskiwania</button>
    </form>
</div>

