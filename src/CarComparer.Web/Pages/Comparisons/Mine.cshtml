@page "/moje-porownania"
@model CarComparer.Web.Pages.Comparisons.MineModel
@{
    ViewData["Title"] = "Moje porównania";
}

<h1 class="h2 mb-3">Moje porównania</h1>

@if (Model.Rows.Count == 0)
{
    <p>Nie masz jeszcze zapisanych porównań.</p>
    <a class="btn btn-primary" asp-page="/Comparisons/New">Nowe porównanie</a>
}
else
{
    <div class="card"><div class="table-responsive"><table class="table align-middle mb-0">
        <thead><tr><th>Utworzono</th><th>Samochody</th><th></th></tr></thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@row.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                <td>
                    @foreach (var car in row.Cars)
                    {
                        <div>@(car is null ? "(brak danych)" : $"{car.Name}, {car.Year}, {car.Price:N0} {car.Currency}")</div>
                    }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-page="Details" asp-route-id="@row.Id">Otwórz</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@row.Id" class="d-inline" data-confirm="Usunąć to porównanie?">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Usuń</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table></div></div>
    <form method="post" asp-page-handler="DeleteAll" class="mt-3" data-confirm="Usunąć wszystkie porównania? Tej operacji nie można cofnąć.">
        <button type="submit" class="btn btn-danger">Wyczyść wszystkie</button>
    </form>
}
